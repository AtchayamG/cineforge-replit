# Runtime Mode: 'live' for real Gemini API calls, 'demo' for deterministic local fixtures
RUNTIME_MODE=demo

# Google Gemini Configuration
GEMINI_API_KEY=
# Optional keyless path for Replit: a token-protected Cloud Run service using Vertex ADC.
GEMINI_RELAY_URL=
GEMINI_RELAY_TOKEN=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.7-flash

# Server Configuration
PORT=8004
HOST=0.0.0.0
DEBUG=false
ENABLE_MOCK_FALLBACK=false

# Replit Environment (Auto-populated in Replit Cloud)
REPL_ID=
# Replit sets REPL_SLUG in its container; leave empty off-Replit.
REPL_SLUG=
REPL_OWNER=
REPLIT_DEPLOYMENT_URL=
# Replit populates these automatically; do not set them locally.
REPLIT_DOMAINS=
REPLIT_DEV_DOMAIN=
REPLIT_DEPLOYMENT=
